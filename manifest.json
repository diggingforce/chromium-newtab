{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "name": "chromium-newtab",
  "version": "1.3.0",
  "manifest_version": 3,
  "description": "a custom minimal new tab extension for Chromium-based browsers",
  "author": "diggingforce",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chromium-newtab@diggingforce",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "search"
  ]
}
